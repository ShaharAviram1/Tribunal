# Copy to .env and fill in. .env is ignored by git and refused by the pre-commit hook.
#
# On the atomworks host only three of these belong in .env — OPENROUTER_API_KEY,
# TRIBUNAL_FUNCTION_SECRET and TRIBUNAL_FILING_ENABLED. The other three are set by
# deploy/docker-compose.yml, and the SUPABASE_* pair is not needed there at all.
OPENROUTER_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TRIBUNAL_FILING_ENABLED=
TRIBUNAL_FUNCTION_SECRET=
TRIBUNAL_STORE=
# 1 when the process runs on a host whose filesystem outlives the request, which is what makes
# TRIBUNAL_STORE=file legitimate; unset anywhere a platform can discard the filesystem.
TRIBUNAL_PERSISTENT_HOST=
# Where the file store keeps deliberations. Defaults to the repository's runs/; the container
# points it at the mounted volume.
TRIBUNAL_RUNS_DIR=
