#!/bin/sh
# Tribunal pre-commit gates. Documented in docs/05-verification/gates.md.
# Each gate prints its own name on failure. All gates run; any failure refuses the commit.
set -u
fail=0

# G1: no API key in the staged diff.
if git diff --cached -U0 | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -Eq 'sk-or-[A-Za-z0-9_-]{16,}|sk-[A-Za-z0-9]{32,}|eyJ[A-Za-z0-9_-]{30,}\.[A-Za-z0-9_-]{30,}\.'; then
  echo "GATE G1 REFUSED: staged diff contains something shaped like an API key or JWT." >&2
  git diff --cached -U0 | grep -nE 'sk-or-[A-Za-z0-9_-]{16,}|sk-[A-Za-z0-9]{32,}|eyJ[A-Za-z0-9_-]{30,}\.' | sed 's/\(sk-[A-Za-z0-9_-]\{8\}\)[A-Za-z0-9_-]*/\1.../' >&2
  fail=1
fi

# G2: .env is never staged.
if git diff --cached --name-only | grep -E '(^|/)\.env(\..*)?$' | grep -Evq '\.env\.example$'; then
  echo "GATE G2 REFUSED: a .env file is staged." >&2
  git diff --cached --name-only | grep -E '(^|/)\.env' | grep -Ev '\.env\.example$' >&2
  fail=1
fi

# G3: no combined-verdict vocabulary in source, prompts, or the page.
if git diff --cached --name-only -- src tests netlify prompts public | grep -q .; then
  # tests/protocol/no-aggregation.test.ts is exempt: it exists to name these words and forbid them.
  hits=$(git diff --cached -U0 -- src tests netlify prompts public ':(exclude)tests/protocol/no-aggregation.test.ts' | grep -E '^\+' | grep -Ev '^\+\+\+' \
    | grep -inE 'final verdict|majority|consensus|combined verdict|aggregate' || true)
  if [ -n "$hits" ]; then
    echo "GATE G3 REFUSED: staged source uses combined-verdict vocabulary." >&2
    echo "$hits" >&2
    fail=1
  fi
fi

# G4: the offline suite passes with no key in the environment.
log=$(mktemp)
if ! env -u OPENROUTER_API_KEY npm test --silent >"$log" 2>&1; then
  echo "GATE G4 REFUSED: offline test suite failed." >&2
  grep -E "^(✖|not ok|ℹ fail)" "$log" >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "Commit refused. Fix the gates above; do not bypass with --no-verify." >&2
  exit 1
fi
